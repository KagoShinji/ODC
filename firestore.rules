rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /contactSubmissions/{docId} {
      allow create: if
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0 &&
        request.resource.data.goal is string && request.resource.data.goal.size() > 0 &&
        request.resource.data.submittedAt == request.time &&
        request.resource.data.keys().hasOnly([
          'name', 'email', 'company', 'goal', 'submittedAt', 'userAgent', 'referrer'
        ]);

      allow read, delete: if request.auth != null;
      allow update: if false;
    }

    match /invoices/{docId} {
      allow get: if request.auth != null || resource == null || resource.data.status != 'paid';
      allow list, create, update, delete: if request.auth != null;
    }

    match /expenses/{docId} {
      function linked(data) { return data.get('source', '') == 'allowance_liquidation' || data.keys().hasAny(['liquidationId', 'allowanceAccountId']); }
      allow read: if request.auth != null;
      allow create: if request.auth != null && !linked(request.resource.data) && !docId.matches('allowance_liquidation_.*');
      allow update: if request.auth != null && !linked(resource.data) && !linked(request.resource.data) && !docId.matches('allowance_liquidation_.*');
      allow delete: if request.auth != null && !linked(resource.data) && !docId.matches('allowance_liquidation_.*');
    }

    match /moas/{docId} {
      allow get: if request.auth != null || resource == null || resource.data.get('clientSigned', false) != true;
      allow create, delete: if request.auth != null;
      allow list: if request.auth != null;
      allow update: if request.auth != null || (
        resource.data.get('clientSigned', false) != true &&
        request.resource.data.clientSigned == true &&
        request.resource.data.clientSigneeName is string &&
        request.resource.data.clientSigneeName.size() > 0
      );
    }

    match /supportTickets/{ticketId} {
      allow read, create, update, delete: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, create, update, delete: if request.auth != null;
      }
    }

    match /clients/{docId} {
      allow get: if true;
      allow list, create, update, delete: if request.auth != null;
    }

    match /maintenanceSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /serviceInquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /inventory/{docId} {
      allow read, create, update, delete: if request.auth != null;
    }

    match /certificates/{docId} {
      allow create, delete: if request.auth != null;
      allow list: if request.auth != null;
      allow get: if request.auth != null || resource == null || resource.data.status != 'Accepted';
      allow update: if request.auth != null || (
        resource.data.status == 'Pending' &&
        request.resource.data.status == 'Accepted' &&
        request.resource.data.signeeName is string &&
        request.resource.data.signeeName.size() > 0
      );
    }

    match /staff/{docId} {
      allow read, write: if request.auth != null;
    }

    match /salaryPayouts/{docId} {
      allow read, write: if request.auth != null;
    }

    match /clientFeedback/{docId} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }

    match /domains/{docId} {
      allow read, write: if request.auth != null;
    }

    function allowanceActive() {
      return request.auth != null && exists(/databases/$(database)/documents/allowanceAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/allowanceAccess/$(request.auth.uid)).data.active == true
        && (get(/databases/$(database)/documents/allowanceAccess/$(request.auth.uid)).data.get('staffId', '') == ''
          || get(/databases/$(database)/documents/staff/$(get(/databases/$(database)/documents/allowanceAccess/$(request.auth.uid)).data.staffId)).data.status == 'active');
    }
    function allowanceReviewer() {
      return allowanceActive() && get(/databases/$(database)/documents/allowanceAccess/$(request.auth.uid)).data.actions.hasAny([
        'allowances:manage', 'allowances:review', 'allowances:approve', 'allowances:release', 'allowances:reports', 'allowances:reverse'
      ]);
    }
    function allowanceRead() { return allowanceActive() && (resource.data.ownerUid == request.auth.uid || allowanceReviewer()); }
    match /allowanceAccess/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || allowanceReviewer());
      allow list: if allowanceReviewer();
      allow write: if false;
    }
    match /allowanceSettings/{id} { allow read: if allowanceActive(); allow write: if false; }
    match /allowancePolicies/{id} { allow read: if allowanceActive(); allow write: if false; }
    match /{collection}/{id} {
      allow read: if collection in ['allowanceAccounts', 'allowanceMeetings', 'allowanceLiquidations', 'allowanceRequisitions', 'allowanceLedger', 'allowanceAuditEvents', 'allowanceDailyFuel', 'allowanceAttachments', 'allowanceReleases'] && allowanceRead();
      allow write: if false;
    }
    match /allowanceLiquidations/{id}/revisions/{revision} {
      allow read: if allowanceActive() && (resource.data.ownerUid == request.auth.uid || allowanceReviewer());
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
