      allow create: if currentOperation('allowances', request.resource.data) && id == request.resource.data.lastOperationId && request.resource.data.actorUid == request.auth.uid && request.resource.data.command == operation('allowances', request.resource.data).command && recent(request.resource.data.createdAt) &&
        (operation('allowances', request.resource.data).command in ['savePolicy', 'grantAccess', 'configureAccount'] ? request.resource.data.ownerUid == request.auth.uid : request.resource.data.ownerUid == account(request.resource.data).ownerUid);
      allow update, delete: if false;
    }
    match /allowanceAccounts/{id} { allow read: if allowanceRead(); }
    match /allowanceMeetings/{id} { allow read: if allowanceRead(); }
    match /allowanceLiquidations/{id} { allow read: if allowanceRead(); }
    match /allowanceRequisitions/{id} { allow read: if allowanceRead(); }
    match /allowanceLedger/{id} { allow read: if allowanceRead(); }
    match /allowanceAuditEvents/{id} { allow read: if allowanceRead(); }
    match /allowanceDailyFuel/{id} { allow read: if allowanceRead(); }
    match /allowanceAttachments/{id} { allow read: if allowanceRead(); }
    match /allowanceReleases/{id} { allow read: if allowanceRead(); }
    match /allowanceFuelReceipts/{id} { allow read: if allowanceRead(); }
    match /allowanceReferenceFuelClaims/{id} { allow read: if allowanceRead(); }
    match /allowanceLiquidations/{id}/revisions/{revision} { allow read: if active('allowances') && (resource.data.ownerUid == request.auth.uid || allowanceReviewer()); }

    // Task board: every signed-in staff member can see tasks; creators and task managers edit,
    // assignees may only move status, tick checklist items and post progress notes.
    function taskManager() { return operationsRoot() || staffAction('tasks:manage'); }
    function taskCreator() { return taskManager() || staffAction('tasks:create'); }
    function validTask(data) {
      return data.keys().hasOnly(['title', 'description', 'priority', 'status', 'dueAt', 'assignees', 'assigneeEmails', 'checklist', 'activity',
          'createdByUid', 'createdByEmail', 'createdByName', 'createdAt', 'updatedAt', 'completedAt',
          'category', 'salesLeadId', 'salesActivity', 'salesWeek']) &&
        data.get('category', 'general') in ['general', 'sales'] &&
        (data.get('category', 'general') == 'sales' || !data.keys().hasAny(['salesLeadId', 'salesActivity', 'salesWeek'])) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
        data.description is string && data.description.size() <= 5000 &&
        data.priority in ['low', 'medium', 'high', 'urgent'] &&
        data.status in ['todo', 'in_progress', 'blocked', 'done'] &&
        data.dueAt is timestamp &&
        data.assignees is list && data.assigneeEmails is list && data.assigneeEmails.size() <= 30 &&
        data.checklist is list && data.checklist.size() <= 50 &&
        data.activity is list && data.activity.size() <= 60;
    }
    function taskAssignee() { return request.auth.token.email != null && resource.data.assigneeEmails.hasAny([request.auth.token.email.lower()]); }
    // Sales tasks live on the same board. Sales staff may post them for themselves; managers for anyone;
    // anyone in sales may endorse a prospect to a developer. Sales tasks are never public by link.
    function salesTask(data) { return data.get('category', 'general') == 'sales'; }
    function salesTaskCreator(data) {
      return salesTask(data) && salesMember() && data.assigneeEmails.size() >= 1 && data.assigneeEmails.size() <= 5 &&
        (data.assigneeEmails.hasOnly([myEmail()]) || salesManager() || data.get('salesActivity', '') == 'demo_endorsement');
    }
    match /tasks/{taskId} {
      allow get: if request.auth != null || resource == null || !salesTask(resource.data);
      allow list: if request.auth != null;
      allow create: if request.auth != null && (taskCreator() || salesTaskCreator(request.resource.data)) && validTask(request.resource.data) &&
        request.resource.data.status == 'todo' && request.resource.data.createdByUid == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && validTask(request.resource.data) &&
        request.resource.data.createdByUid == resource.data.createdByUid && request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.get('category', 'general') == resource.data.get('category', 'general') &&
        (resource.data.createdByUid == request.auth.uid || taskManager() || (salesTask(resource.data) && salesManager()) ||
          (taskAssignee() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'checklist', 'activity', 'updatedAt', 'completedAt']) &&
            request.resource.data.checklist.size() == resource.data.checklist.size()));
      allow delete: if request.auth != null && (resource.data.createdByUid == request.auth.uid || taskManager() ||
        (salesTask(resource.data) && salesMember() && resource.data.get('salesLeadId', '') != '' && leadGone(resource.data.salesLeadId)));
    }

    // ─── Sales management ───
    // Authority comes only from Staff Management grants (sales:*). Identity is the login email, as on the task board.
    function myEmail() { return request.auth.token.email.lower(); }
    function salesProfile() { return record('staff', record('staffLoginIdentities', request.auth.uid).staffId); }
    function salesGrant(actions) { return operationsRoot() || (request.auth != null && salesProfile().status == 'active' && salesProfile().allowedActions.hasAny(actions)); }
    function salesMember() { return salesGrant(['sales:associate', 'sales:manage', 'sales:confirm', 'sales:targets']); }
    function salesManager() { return salesGrant(['sales:manage', 'sales:confirm']); }
    function salesViewer() { return salesGrant(['sales:manage', 'sales:confirm', 'sales:targets']); }
    function salesConfirmer() { return salesGrant(['sales:confirm']); }
    function salesTargeter() { return salesGrant(['sales:targets']); }
    function leadBefore(id) { return record('salesLeads', id); }
    function leadAfter(id) { return afterRecord('salesLeads', id); }
    function dealAfter(id) { return afterRecord('salesDeals', id); }
    // True once a lead is deleted (in this batch or earlier): its activities, keys, deal and tasks may then be cleaned up.
    function leadGone(id) { return !existsAfter(/databases/$(database)/documents/salesLeads/$(id)); }
    // Wrong or incorrect leads can be deleted unless they are converted or awaiting conversion review.
    // Managers can delete any such lead; associates only leads they added, still own, and that are still New.
    function leadDeletable(lead) {
      return lead.stage != 'converted' && !(lead.conversionStatus in ['pending', 'confirmed']) &&
        (salesManager() || (lead.createdByUid == request.auth.uid && lead.ownerEmail == myEmail() && lead.stage == 'new'));
    }
    function salesText(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function salesMoney(value) { return value is int && value >= 0 && value <= 10000000000; }
    function optionalTime(value) { return value == null || value is timestamp; }
    function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
    function stampedByMe(data) { return data.updatedAt == request.time && data.updatedByUid == request.auth.uid; }

    function validLead(d) {
      return d.keys().hasOnly(['businessName', 'industry', 'location', 'contactName', 'contactNumber', 'facebookUrl', 'websiteUrl', 'email', 'source', 'notes',
          'qualified', 'disqualifyReason', 'ownerEmail', 'ownerName', 'attributedEmail', 'attributedName', 'stage', 'stageChangedAt', 'lostReason', 'lostNotes',
          'nextFollowUpAt', 'duplicateKeys', 'possibleDuplicateOf', 'duplicateStatus', 'firstContactedAt', 'firstResponseAt', 'conversionStatus', 'convertedAt',
          'createdAt', 'createdByUid', 'createdByEmail', 'createdByName', 'updatedAt', 'updatedByUid']) &&
        salesText(d.businessName, 1, 200) && salesText(d.industry, 1, 80) && salesText(d.source, 1, 80) &&
        salesText(d.location, 0, 200) && salesText(d.contactName, 0, 120) && salesText(d.contactNumber, 0, 40) && salesText(d.facebookUrl, 0, 500) &&
        salesText(d.websiteUrl, 0, 500) && salesText(d.email, 0, 200) && salesText(d.notes, 0, 5000) &&
        (d.contactNumber.size() > 0 || d.email.size() > 0 || d.facebookUrl.size() > 0 || d.websiteUrl.size() > 0) &&
        d.qualified is bool && salesText(d.disqualifyReason, 0, 500) && (d.qualified || d.disqualifyReason.size() > 0) &&
        salesText(d.ownerEmail, 3, 200) && salesText(d.ownerName, 0, 200) && salesText(d.attributedEmail, 3, 200) && salesText(d.attributedName, 0, 200) &&
        d.stage in ['new', 'contacted', 'interested', 'consultation', 'quotation', 'negotiation', 'converted', 'lost'] && d.stageChangedAt is timestamp &&
        (d.stage == 'lost' ? d.lostReason in ['not_interested', 'no_response', 'budget', 'existing_system', 'postponed', 'other_provider', 'other'] : d.lostReason == '') &&
        salesText(d.lostNotes, 0, 1000) && optionalTime(d.nextFollowUpAt) && (!(d.stage in ['converted', 'lost']) || d.nextFollowUpAt == null) &&
        d.duplicateKeys is list && d.duplicateKeys.size() <= 10 && d.possibleDuplicateOf is list && d.possibleDuplicateOf.size() <= 20 &&
        d.duplicateStatus in ['none', 'pending_review', 'not_duplicate', 'duplicate'] &&
        optionalTime(d.firstContactedAt) && optionalTime(d.firstResponseAt) &&
        d.conversionStatus in ['none', 'pending', 'confirmed', 'rejected'] && optionalTime(d.convertedAt) && stampedByMe(d);
    }
    // Converted is reached only together with a confirmed deal; a confirmed client is locked.
    function leadConversionOk(before, d, id) {
      return before.stage == 'converted'
        ? d.stage == 'converted' && d.conversionStatus == before.conversionStatus && d.convertedAt == before.convertedAt
        : (d.stage == 'converted'
          ? salesConfirmer() && d.conversionStatus == 'confirmed' && d.convertedAt == request.time && dealAfter(id).status == 'confirmed'
          : d.convertedAt == null && d.conversionStatus != 'confirmed' && (d.conversionStatus == before.conversionStatus || d.conversionStatus == dealAfter(id).status));
    }
    function leadMilestonesOk(before, d) {
      return (before.firstContactedAt == null || d.firstContactedAt == before.firstContactedAt) && (before.firstResponseAt == null || d.firstResponseAt == before.firstResponseAt) &&
        (d.stage == before.stage ? d.stageChangedAt == before.stageChangedAt : d.stageChangedAt == request.time);
    }
    match /salesLeads/{leadId} {
      allow read: if salesViewer() || (salesMember() && (resource.data.ownerEmail == myEmail() || resource.data.attributedEmail == myEmail()));
      allow create: if salesMember() && validLead(request.resource.data) &&
        request.resource.data.createdByUid == request.auth.uid && request.resource.data.createdByEmail == myEmail() && request.resource.data.createdAt == request.time &&
        request.resource.data.stage == 'new' && request.resource.data.stageChangedAt == request.time && request.resource.data.qualified == true &&
        request.resource.data.duplicateStatus in ['none', 'pending_review'] && request.resource.data.conversionStatus == 'none' && request.resource.data.convertedAt == null &&
        request.resource.data.firstContactedAt == null && request.resource.data.firstResponseAt == null &&
        request.resource.data.attributedEmail == request.resource.data.ownerEmail && (request.resource.data.ownerEmail == myEmail() || salesManager());
      allow update: if salesMember() && validLead(request.resource.data) &&
        unchanged(['createdAt', 'createdByUid', 'createdByEmail', 'createdByName', 'attributedEmail', 'attributedName']) &&
        leadConversionOk(resource.data, request.resource.data, leadId) && leadMilestonesOk(resource.data, request.resource.data) &&
        (salesManager() || (resource.data.ownerEmail == myEmail() &&
          unchanged(['ownerEmail', 'ownerName', 'qualified', 'disqualifyReason', 'duplicateStatus', 'possibleDuplicateOf']) &&
          request.resource.data.conversionStatus in [resource.data.conversionStatus, 'pending']));
      allow delete: if salesMember() && leadDeletable(resource.data);
    }
    // Identifier index for duplicate warnings across owners; it reveals only the matching business name and owner.
    match /salesLeadKeys/{keyId} {
      allow get: if salesMember();
      allow create: if salesMember() && request.resource.data.keys().hasOnly(['leadId', 'type', 'businessName', 'ownerName', 'createdAt']) &&
        request.resource.data.createdAt == request.time && request.resource.data.type in ['name', 'phone', 'web', 'fb', 'email'] && keyId.matches(request.resource.data.type + '_.+') &&
        salesText(request.resource.data.businessName, 1, 200) && salesText(request.resource.data.ownerName, 0, 200) &&
        (salesManager() || leadAfter(request.resource.data.leadId).ownerEmail == myEmail());
      allow delete: if salesMember() && leadGone(resource.data.leadId);
      allow list, update: if false;
    }
    function validActivity(d, leadId) {
      let lead = leadAfter(leadId);
      return d.keys().hasOnly(['leadId', 'type', 'notes', 'byUid', 'byEmail', 'byName', 'at', 'attributedEmail', 'ownerEmail', 'industry', 'fromStage', 'toStage', 'scheduledAt', 'detail']) &&
        d.industry == lead.industry &&
        d.leadId == leadId && d.byUid == request.auth.uid && d.byEmail == myEmail() && salesText(d.byName, 0, 200) && d.at == request.time &&
        salesText(d.notes, 0, 2000) && salesText(d.detail, 0, 300) && optionalTime(d.scheduledAt) &&
        d.attributedEmail == lead.attributedEmail && d.ownerEmail == lead.ownerEmail &&
        d.type in ['initial_contact', 'follow_up', 'call', 'email', 'response', 'consultation_scheduled', 'consultation', 'demo', 'quotation_sent', 'negotiation', 'note',
          'created', 'stage_change', 'assignment', 'conversion_requested', 'conversion_rejected', 'payment_confirmed', 'endorsed', 'duplicate_review', 'qualification'] &&
        (d.type != 'created' || (!exists(/databases/$(database)/documents/salesLeads/$(leadId)) && lead.createdByUid == request.auth.uid)) &&
        (d.type != 'stage_change' || (d.fromStage == leadBefore(leadId).stage && d.toStage == lead.stage && d.fromStage != d.toStage)) &&
        (!(d.type in ['assignment', 'duplicate_review', 'qualification', 'conversion_rejected']) || salesManager()) &&
        (d.type != 'payment_confirmed' || (salesConfirmer() && lead.stage == 'converted'));
    }
    match /salesLeads/{leadId}/salesActivities/{activityId} {
      allow read: if salesViewer() || (salesMember() && (leadBefore(leadId).ownerEmail == myEmail() || leadBefore(leadId).attributedEmail == myEmail()));
      allow create: if salesMember() && validActivity(request.resource.data, leadId) && (salesManager() || leadAfter(leadId).ownerEmail == myEmail());
      allow delete: if salesMember() && leadGone(leadId);
      allow update: if false;
    }
    match /{path=**}/salesActivities/{activityId} {
      allow read: if salesViewer() || (salesMember() && resource.data.attributedEmail == myEmail());
    }
    function validDeal(d, leadId) {
      let lead = leadAfter(leadId);
      return d.keys().hasOnly(['leadId', 'businessName', 'industry', 'attributedEmail', 'attributedName', 'ownerEmail', 'leadCreatedAt', 'service', 'quotedCentavos', 'finalCentavos',
          'downPaymentCentavos', 'paymentDate', 'paymentReference', 'requestNotes', 'status', 'submittedByUid', 'submittedByEmail', 'submittedByName', 'submittedAt',
          'reviewNotes', 'reviewedByUid', 'reviewedByName', 'reviewedAt', 'confirmedAt', 'updatedAt']) &&
        d.leadId == leadId && d.attributedEmail == lead.attributedEmail && d.leadCreatedAt == lead.createdAt && salesText(d.businessName, 1, 200) && d.industry == lead.industry &&
        salesText(d['service'], 1, 200) && salesMoney(d.quotedCentavos) && d.quotedCentavos > 0 && salesMoney(d.finalCentavos) && salesMoney(d.downPaymentCentavos) &&
        salesText(d.paymentDate, 0, 10) && salesText(d.paymentReference, 0, 120) && salesText(d.requestNotes, 0, 1000) && salesText(d.reviewNotes, 0, 1000) &&
        d.status in ['pending', 'confirmed', 'rejected'] && optionalTime(d.reviewedAt) && optionalTime(d.confirmedAt) && d.updatedAt == request.time;
    }
    function dealSubmission(d, leadId) {
      return d.status == 'pending' && d.submittedByUid == request.auth.uid && d.submittedByEmail == myEmail() && d.submittedAt == request.time &&
        d.confirmedAt == null && (salesManager() || leadAfter(leadId).ownerEmail == myEmail()) &&
        leadAfter(leadId).conversionStatus == 'pending' && leadAfter(leadId).stage in ['quotation', 'negotiation'];
    }
    match /salesDeals/{leadId} {
      // A missing deal may be checked by anyone in sales: conversion requests read it inside their transaction.
      allow read: if salesViewer() || (salesMember() && (resource == null || resource.data.attributedEmail == myEmail() || resource.data.ownerEmail == myEmail()));
      allow create: if salesMember() && validDeal(request.resource.data, leadId) && dealSubmission(request.resource.data, leadId) && request.resource.data.reviewedAt == null;
      allow update: if salesMember() && validDeal(request.resource.data, leadId) && resource.data.status != 'confirmed' &&
        unchanged(['leadId', 'attributedEmail', 'attributedName', 'leadCreatedAt']) && (
          (resource.data.status == 'rejected' && dealSubmission(request.resource.data, leadId)) ||
          (resource.data.status == 'pending' && request.resource.data.status == 'pending' && (salesManager() || resource.data.ownerEmail == myEmail()) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['service', 'quotedCentavos', 'finalCentavos', 'downPaymentCentavos', 'paymentDate', 'paymentReference', 'requestNotes', 'updatedAt'])) ||
          (resource.data.status == 'pending' && request.resource.data.status == 'rejected' && salesManager() && request.resource.data.reviewNotes.size() > 0 &&
            request.resource.data.reviewedByUid == request.auth.uid && request.resource.data.reviewedAt == request.time && request.resource.data.confirmedAt == null &&
            leadAfter(leadId).conversionStatus == 'rejected') ||
          (resource.data.status == 'pending' && request.resource.data.status == 'confirmed' && salesConfirmer() &&
            request.resource.data.reviewedByUid == request.auth.uid && request.resource.data.reviewedAt == request.time && request.resource.data.confirmedAt == request.time &&
            request.resource.data.downPaymentCentavos > 0 && request.resource.data.finalCentavos >= request.resource.data.downPaymentCentavos &&
            request.resource.data.paymentDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && leadAfter(leadId).stage == 'converted'));
      allow delete: if salesMember() && resource.data.status != 'confirmed' && leadGone(leadId);
    }
    match /salesTargets/{effectiveFrom} {
      allow read: if salesMember();
      allow create, update: if salesTargeter() && request.resource.data.keys().hasOnly(['weeklyLeadsPerAssociate', 'monthlyLeadsPerAssociate', 'minConversionPercent',
          'weeklyConversionTarget', 'monthlyConversionTarget', 'effectiveFrom', 'updatedAt', 'updatedByUid', 'updatedByName']) &&
        request.resource.data.effectiveFrom == effectiveFrom && validDate(effectiveFrom) && stampedByMe(request.resource.data) &&
        request.resource.data.weeklyLeadsPerAssociate is int && request.resource.data.weeklyLeadsPerAssociate > 0 &&
        request.resource.data.monthlyLeadsPerAssociate is int && request.resource.data.monthlyLeadsPerAssociate > 0 &&
        request.resource.data.minConversionPercent is number && request.resource.data.minConversionPercent > 0 && request.resource.data.minConversionPercent <= 100 &&
        request.resource.data.weeklyConversionTarget is int && request.resource.data.weeklyConversionTarget >= 0 &&
        request.resource.data.monthlyConversionTarget is int && request.resource.data.monthlyConversionTarget >= 0;
      allow delete: if false;
    }
    match /salesSettings/{id} {
      allow read: if salesMember();
      allow create, update: if id == 'current' && salesTargeter() && stampedByMe(request.resource.data) &&
        request.resource.data.keys().hasOnly(['timezone', 'weekStartsOn', 'categories', 'automation', 'quotationFollowUpDays', 'updatedAt', 'updatedByUid', 'updatedByName']) &&
        salesText(request.resource.data.timezone, 3, 60) && request.resource.data.weekStartsOn is int && request.resource.data.weekStartsOn >= 0 && request.resource.data.weekStartsOn <= 6 &&
        request.resource.data.categories is list && request.resource.data.categories.size() > 0 && request.resource.data.categories.size() <= 50 &&
        request.resource.data.automation is map && request.resource.data.quotationFollowUpDays is int && request.resource.data.quotationFollowUpDays >= 1 && request.resource.data.quotationFollowUpDays <= 30;
      allow delete: if false;
    }
    // Weekly self-reports: the associate's narrative and snapshot. Official KPIs are always recomputed from records.
    match /salesWeeklyReports/{reportId} {
      allow read: if salesViewer() || (salesMember() && resource.data.email == myEmail());
      allow create, update: if salesMember() && reportId == request.resource.data.weekKey + '_' + request.auth.uid && validDate(request.resource.data.weekKey) &&
        request.resource.data.keys().hasOnly(['weekKey', 'uid', 'email', 'name', 'snapshot', 'notes', 'submittedAt']) && request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == myEmail() && request.resource.data.snapshot is map && salesText(request.resource.data.notes, 0, 3000) && request.resource.data.submittedAt == request.time;
      allow delete: if false;
    }
    match /salesNotifications/{id} {
      allow read: if request.auth != null && resource.data.recipientEmail == myEmail();
      allow create: if salesMember() && request.resource.data.keys().hasOnly(['recipientEmail', 'type', 'title', 'body', 'leadId', 'read', 'createdAt', 'createdByUid']) &&
        salesText(request.resource.data.recipientEmail, 3, 200) && salesText(request.resource.data.type, 1, 40) && salesText(request.resource.data.title, 1, 200) &&
        salesText(request.resource.data.body, 0, 1000) && salesText(request.resource.data.leadId, 0, 128) && request.resource.data.read == false &&
        request.resource.data.createdAt == request.time && request.resource.data.createdByUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.recipientEmail == myEmail() && request.resource.data.read == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ─── Office Orders ───
    // Drafted by management, locked once issued. Issued and revoked orders are readable by their unguessable link.
    function officeOrderAdmin() { return operationsRoot() || (request.auth != null && staffAction('officeorders:manage')); }
    function seqText(n) { return (n < 10 ? '00' : n < 100 ? '0' : '') + string(n); }
    function validOfficeOrder(d) {
      return d.keys().hasOnly(['controlNumber', 'controlMonth', 'controlSeq', 'subject', 'to', 'cc', 'fromName', 'fromTitle', 'date', 'effectivity', 'body', 'bodyJson', 'signers', 'status',
          'createdAt', 'createdByUid', 'createdByName', 'updatedAt', 'updatedByUid', 'issuedAt', 'revokedAt', 'revokedReason']) &&
        docText(d.subject, 1, 300) && docText(d.to, 0, 300) && docText(d.cc, 0, 300) && docText(d.fromName, 0, 200) && docText(d.fromTitle, 0, 200) &&
        docText(d.date, 0, 10) && docText(d.effectivity, 0, 10) && docText(d.body, 0, 80000) && docText(d.get('bodyJson', ''), 0, 400000) && d.signers is map && d.signers.size() <= 12 &&
        d.status in ['draft', 'issued', 'revoked'] && docText(d.revokedReason, 0, 500) &&
        d.controlMonth.matches('[0-9]{4}-[0-9]{2}') && d.controlSeq is int && d.controlSeq > 0 && d.controlNumber == 'OO-' + d.controlMonth + '-' + seqText(d.controlSeq) &&
        d.updatedAt == request.time && d.updatedByUid == request.auth.uid;
    }
    match /officeOrderCounters/{month} {
      allow get: if officeOrderAdmin();
      allow create, update: if officeOrderAdmin() && month.matches('[0-9]{4}-[0-9]{2}') && request.resource.data.keys().hasOnly(['last']) &&
        request.resource.data.last == (resource == null ? 1 : resource.data.last + 1);
      allow list, delete: if false;
    }
    match /officeOrders/{orderId} {
      allow get: if officeOrderAdmin() || resource.data.status in ['issued', 'revoked'];
      allow list: if officeOrderAdmin();
      allow create: if officeOrderAdmin() && validOfficeOrder(request.resource.data) && request.resource.data.status == 'draft' &&
        request.resource.data.createdAt == request.time && request.resource.data.createdByUid == request.auth.uid &&
        afterRecord('officeOrderCounters', request.resource.data.controlMonth).last == request.resource.data.controlSeq;
      allow update: if officeOrderAdmin() && validOfficeOrder(request.resource.data) &&
        unchanged(['controlNumber', 'controlMonth', 'controlSeq', 'createdAt', 'createdByUid', 'createdByName']) &&
        (resource.data.status == 'draft'
          ? request.resource.data.status == 'draft' || (request.resource.data.status == 'issued' && request.resource.data.issuedAt == request.time)
          : resource.data.status == 'issued' && request.resource.data.status == 'revoked' && request.resource.data.revokedAt == request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt', 'revokedReason', 'updatedAt', 'updatedByUid']));
      allow delete: if officeOrderAdmin() && resource.data.status == 'draft';

      // One immutable signature per signer slot. The issuer signs from an admin session; co-signers and
      // acknowledgers sign through the link by typing the name listed on the order (any name if the slot lists a role only).
      match /signatures/{slotId} {
        allow read: if officeOrderAdmin() || record('officeOrders', orderId).status in ['issued', 'revoked'];
        allow create: if record('officeOrders', orderId).status == 'issued' && record('officeOrders', orderId).signers.keys().hasAny([slotId]) &&
          request.resource.data.keys().hasOnly(['name', 'signedAt', 'signedByUid', 'userAgent']) && docText(request.resource.data.name, 2, 200) &&
          request.resource.data.signedAt == request.time && docText(request.resource.data.userAgent, 0, 300) &&
          request.resource.data.signedByUid == (request.auth == null ? '' : request.auth.uid) &&
          (record('officeOrders', orderId).signers[slotId].name == '' || request.resource.data.name.trim().lower() == record('officeOrders', orderId).signers[slotId].name.trim().lower()) &&
          (record('officeOrders', orderId).signers[slotId].kind != 'issuer' || officeOrderAdmin());
        allow update, delete: if false;
      }
    }

    // ─── Incident Reports ───
    function incidentReportAdmin() { return operationsRoot() || (request.auth != null && staffAction('incidentreports:manage')); }
    function validIncidentReport(d) {
      return d.keys().hasOnly(['controlNumber', 'controlMonth', 'controlSeq', 'title', 'incidentDate', 'incidentTime',
          'dateReported', 'location', 'category', 'severity', 'reportedByName', 'reportedByTitle', 'personsInvolved',
          'body', 'bodyJson', 'signers', 'status', 'statusReason', 'createdAt', 'createdByUid', 'createdByName',
          'updatedAt', 'updatedByUid', 'issuedAt', 'closedAt', 'revokedAt']) &&
        docText(d.title, 1, 300) && docText(d.incidentDate, 0, 20) && docText(d.incidentTime, 0, 30) &&
        docText(d.dateReported, 0, 20) && docText(d.location, 0, 200) &&
        d.category in ['operational', 'security', 'conduct', 'safety', 'equipment', 'other'] &&
        d.severity in ['low', 'medium', 'high', 'critical'] &&
        docText(d.reportedByName, 0, 200) && docText(d.reportedByTitle, 0, 200) && docText(d.personsInvolved, 0, 300) &&
        docText(d.body, 0, 80000) && docText(d.get('bodyJson', ''), 0, 400000) && d.signers is map && d.signers.size() <= 12 &&
        d.status in ['draft', 'issued', 'closed', 'revoked'] && docText(d.get('statusReason', ''), 0, 500) &&
        d.controlMonth.matches('[0-9]{4}-[0-9]{2}') && d.controlSeq is int && d.controlSeq > 0 && d.controlNumber == 'IR-' + d.controlMonth + '-' + seqText(d.controlSeq) &&
        d.updatedAt == request.time && d.updatedByUid == request.auth.uid;
    }
    match /incidentReportCounters/{month} {
      allow get: if incidentReportAdmin();
      allow create, update: if incidentReportAdmin() && month.matches('[0-9]{4}-[0-9]{2}') && request.resource.data.keys().hasOnly(['last']) &&
        request.resource.data.last == (resource == null ? 1 : resource.data.last + 1);
      allow list, delete: if false;
    }
    match /incidentReports/{reportId} {
      allow get: if incidentReportAdmin() || resource.data.status in ['issued', 'closed', 'revoked'];
      allow list: if incidentReportAdmin();
      allow create: if incidentReportAdmin() && validIncidentReport(request.resource.data) && request.resource.data.status == 'draft' &&
        request.resource.data.createdAt == request.time && request.resource.data.createdByUid == request.auth.uid &&
        afterRecord('incidentReportCounters', request.resource.data.controlMonth).last == request.resource.data.controlSeq;
      allow update: if incidentReportAdmin() && validIncidentReport(request.resource.data) &&
        unchanged(['controlNumber', 'controlMonth', 'controlSeq', 'createdAt', 'createdByUid', 'createdByName']) &&
        (resource.data.status == 'draft'
          ? request.resource.data.status == 'draft' || (request.resource.data.status == 'issued' && request.resource.data.issuedAt == request.time)
          : resource.data.status == 'issued' && request.resource.data.status in ['closed', 'revoked'] &&
            ((request.resource.data.status == 'closed' && request.resource.data.closedAt == request.time) ||
             (request.resource.data.status == 'revoked' && request.resource.data.revokedAt == request.time)) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusReason', 'closedAt', 'revokedAt', 'updatedAt', 'updatedByUid']));
      allow delete: if incidentReportAdmin() && resource.data.status == 'draft';

      match /signatures/{slotId} {
        allow read: if incidentReportAdmin() || record('incidentReports', reportId).status in ['issued', 'closed', 'revoked'];
        allow create: if record('incidentReports', reportId).status in ['issued', 'closed'] && record('incidentReports', reportId).signers.keys().hasAny([slotId]) &&
          request.resource.data.keys().hasOnly(['name', 'signedAt', 'signedByUid', 'userAgent']) && docText(request.resource.data.name, 2, 200) &&
          request.resource.data.signedAt == request.time && docText(request.resource.data.userAgent, 0, 300) &&
          request.resource.data.signedByUid == (request.auth == null ? '' : request.auth.uid) &&
          (record('incidentReports', reportId).signers[slotId].name == '' || request.resource.data.name.trim().lower() == record('incidentReports', reportId).signers[slotId].name.trim().lower()) &&
          (record('incidentReports', reportId).signers[slotId].kind != 'approver' || incidentReportAdmin());
        allow update, delete: if false;
      }
    }

    // ─── Audit Reports ───
    function auditReportAdmin() { return operationsRoot() || (request.auth != null && staffAction('auditreports:manage')); }
    function validAuditReport(d) {
      return d.keys().hasOnly(['controlNumber', 'controlMonth', 'controlSeq', 'title', 'category', 'rating',
          'auditPeriodStart', 'auditPeriodEnd', 'auditDate', 'dateIssued',
          'leadAuditorName', 'leadAuditorTitle', 'auditeeEntity', 'auditeeContact', 'auditTeam',
          'referenceNo', 'classification', 'venueDomain',
          'body', 'bodyJson', 'signers', 'status', 'statusReason', 'createdAt', 'createdByUid', 'createdByName',
          'updatedAt', 'updatedByUid', 'issuedAt', 'closedAt', 'revokedAt']) &&
        docText(d.title, 1, 300) &&
        docText(d.get('referenceNo', ''), 0, 100) &&
        docText(d.get('classification', ''), 0, 200) &&
        docText(d.get('venueDomain', ''), 0, 200) &&
        d.category in ['it_security', 'operations', 'financial', 'compliance', 'inventory', 'quality', 'other'] &&
        d.rating in ['satisfactory', 'needs_improvement', 'unsatisfactory'] &&
        docText(d.get('auditPeriodStart', ''), 0, 20) &&
        docText(d.get('auditPeriodEnd', ''), 0, 20) &&
        docText(d.get('auditDate', ''), 0, 20) &&
        docText(d.get('dateIssued', ''), 0, 20) &&
        docText(d.leadAuditorName, 0, 200) &&
        docText(d.leadAuditorTitle, 0, 200) &&
        docText(d.auditeeEntity, 0, 200) &&
        docText(d.get('auditeeContact', ''), 0, 200) &&
        docText(d.get('auditTeam', ''), 0, 300) &&
        docText(d.body, 0, 80000) && docText(d.get('bodyJson', ''), 0, 400000) && d.signers is map && d.signers.size() <= 12 &&
        d.status in ['draft', 'issued', 'closed', 'revoked'] && docText(d.get('statusReason', ''), 0, 500) &&
        d.controlMonth.matches('[0-9]{4}-[0-9]{2}') && d.controlSeq is int && d.controlSeq > 0 && d.controlNumber == 'AR-' + d.controlMonth + '-' + seqText(d.controlSeq) &&
        d.updatedAt == request.time && d.updatedByUid == request.auth.uid;
    }
    match /auditReportCounters/{month} {
      allow get: if auditReportAdmin();
      allow create, update: if auditReportAdmin() && month.matches('[0-9]{4}-[0-9]{2}') && request.resource.data.keys().hasOnly(['last']) &&
        request.resource.data.last == (resource == null ? 1 : resource.data.last + 1);
      allow list, delete: if false;
    }
    match /auditReports/{reportId} {
      allow get: if auditReportAdmin() || resource.data.status in ['issued', 'closed', 'revoked'];
      allow list: if auditReportAdmin();
      allow create: if auditReportAdmin() && validAuditReport(request.resource.data) && request.resource.data.status == 'draft' &&
        request.resource.data.createdAt == request.time && request.resource.data.createdByUid == request.auth.uid &&
        afterRecord('auditReportCounters', request.resource.data.controlMonth).last == request.resource.data.controlSeq;
      allow update: if auditReportAdmin() && validAuditReport(request.resource.data) &&
        unchanged(['controlNumber', 'controlMonth', 'controlSeq', 'createdAt', 'createdByUid', 'createdByName']) &&
        (resource.data.status == 'draft'
          ? request.resource.data.status == 'draft' || (request.resource.data.status == 'issued' && request.resource.data.issuedAt == request.time)
          : resource.data.status == 'issued' && request.resource.data.status in ['closed', 'revoked'] &&
            ((request.resource.data.status == 'closed' && request.resource.data.closedAt == request.time) ||
             (request.resource.data.status == 'revoked' && request.resource.data.revokedAt == request.time)) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusReason', 'closedAt', 'revokedAt', 'updatedAt', 'updatedByUid']));
      allow delete: if auditReportAdmin() && resource.data.status == 'draft';

      match /signatures/{slotId} {
        allow read: if auditReportAdmin() || record('auditReports', reportId).status in ['issued', 'closed', 'revoked'];
        allow create: if record('auditReports', reportId).status in ['issued', 'closed'] && record('auditReports', reportId).signers.keys().hasAny([slotId]) &&
          request.resource.data.keys().hasOnly(['name', 'signedAt', 'signedByUid', 'userAgent']) && docText(request.resource.data.name, 2, 200) &&
          request.resource.data.signedAt == request.time && docText(request.resource.data.userAgent, 0, 300) &&
          request.resource.data.signedByUid == (request.auth == null ? '' : request.auth.uid) &&
          (record('auditReports', reportId).signers[slotId].name == '' || request.resource.data.name.trim().lower() == record('auditReports', reportId).signers[slotId].name.trim().lower()) &&
          (record('auditReports', reportId).signers[slotId].kind != 'approver' || auditReportAdmin());
        allow update, delete: if false;
      }
    }

    // ─── Quotations ───
    function quotationAdmin() { return operationsRoot() || (request.auth != null && staffAction('quotations:manage')); }
    function validQuotation(d) {
      return d.keys().hasOnly(['controlNumber', 'controlMonth', 'controlSeq', 'projectName', 'clientBusiness',
          'clientName', 'clientAddress', 'clientEmail', 'clientPhone', 'date', 'validUntil', 'paymentTerms',
          'items', 'subtotal', 'discountPercent', 'discountAmount', 'taxPercent', 'taxAmount', 'total', 'totalWords',
          'scopeText', 'scopeJson', 'signers', 'status', 'statusReason', 'revokedReason', 'createdAt', 'createdByUid', 'createdByName',
          'updatedAt', 'updatedByUid', 'issuedAt', 'acceptedAt', 'revokedAt']) &&
        docText(d.projectName, 1, 300) &&
        docText(d.clientBusiness, 1, 300) &&
        docText(d.get('clientName', ''), 0, 200) &&
        docText(d.get('clientAddress', ''), 0, 300) &&
        docText(d.get('clientEmail', ''), 0, 100) &&
        docText(d.get('clientPhone', ''), 0, 50) &&
        docText(d.get('date', ''), 0, 20) &&
        docText(d.get('validUntil', ''), 0, 20) &&
        docText(d.get('paymentTerms', ''), 0, 200) &&
        d.items is list && d.items.size() <= 50 &&
        d.subtotal is number && d.subtotal >= 0 &&
        d.discountPercent is number && d.discountPercent >= 0 && d.discountPercent <= 100 &&
        d.discountAmount is number && d.discountAmount >= 0 &&
        d.taxPercent is number && d.taxPercent >= 0 &&
        d.taxAmount is number && d.taxAmount >= 0 &&
        d.total is number && d.total >= 0 &&
        docText(d.get('totalWords', ''), 0, 300) &&
        docText(d.get('scopeText', ''), 0, 80000) &&
        docText(d.get('scopeJson', ''), 0, 400000) &&
        d.signers is map && d.signers.size() <= 12 &&
        d.status in ['draft', 'issued', 'accepted', 'revoked'] &&
        docText(d.get('statusReason', ''), 0, 500) &&
        docText(d.get('revokedReason', ''), 0, 500) &&
        d.controlMonth.matches('[0-9]{4}-[0-9]{2}') && d.controlSeq is int && d.controlSeq > 0 && d.controlNumber == 'QT-' + d.controlMonth + '-' + seqText(d.controlSeq) &&
        d.updatedAt == request.time && d.updatedByUid == request.auth.uid;
    }
    match /quotationCounters/{month} {
      allow get: if quotationAdmin();
      allow create, update: if quotationAdmin() && month.matches('[0-9]{4}-[0-9]{2}') && request.resource.data.keys().hasOnly(['last']) &&
        request.resource.data.last == (resource == null ? 1 : resource.data.last + 1);
      allow list, delete: if false;
    }
    match /quotations/{quotationId} {
      allow get: if quotationAdmin() || resource.data.status in ['issued', 'accepted', 'revoked'];
      allow list: if quotationAdmin();
      allow create: if quotationAdmin() && validQuotation(request.resource.data) && request.resource.data.status == 'draft' &&
        request.resource.data.createdAt == request.time && request.resource.data.createdByUid == request.auth.uid &&
        afterRecord('quotationCounters', request.resource.data.controlMonth).last == request.resource.data.controlSeq;
      allow update: if (
        (quotationAdmin() && validQuotation(request.resource.data) &&
        unchanged(['controlNumber', 'controlMonth', 'controlSeq', 'createdAt', 'createdByUid', 'createdByName']) &&
        (resource.data.status == 'draft'
          ? request.resource.data.status == 'draft' || (request.resource.data.status == 'issued' && request.resource.data.issuedAt == request.time)
          : resource.data.status == 'issued' && request.resource.data.status in ['accepted', 'revoked'] &&
            ((request.resource.data.status == 'accepted' && request.resource.data.acceptedAt == request.time) ||
             (request.resource.data.status == 'revoked' && request.resource.data.revokedAt == request.time)) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusReason', 'revokedReason', 'acceptedAt', 'revokedAt', 'updatedAt', 'updatedByUid'])))
        ||
        (resource.data.status == 'issued' &&
         request.resource.data.status == 'accepted' &&
         request.resource.data.acceptedAt == request.time &&
         request.resource.data.updatedAt == request.time &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'updatedAt', 'updatedByUid']))
      );
      allow delete: if quotationAdmin() && resource.data.status == 'draft';

      match /signatures/{slotId} {
        allow read: if quotationAdmin() || record('quotations', quotationId).status in ['issued', 'accepted', 'revoked'];
        allow create: if record('quotations', quotationId).status in ['issued', 'accepted'] && record('quotations', quotationId).signers.keys().hasAny([slotId]) &&
          request.resource.data.keys().hasOnly(['name', 'title', 'signedAt', 'signedByUid', 'signatureImage', 'userAgent']) && docText(request.resource.data.name, 2, 200) &&
          request.resource.data.signedAt == request.time && docText(request.resource.data.get('userAgent', ''), 0, 300) &&
          request.resource.data.signedByUid == (request.auth == null ? '' : request.auth.uid) &&
          (record('quotations', quotationId).signers[slotId].name == '' || request.resource.data.name.trim().lower() == record('quotations', quotationId).signers[slotId].name.trim().lower()) &&
          (record('quotations', quotationId).signers[slotId].kind != 'prepared' || quotationAdmin());
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
