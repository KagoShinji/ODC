      allow update: if currentOperation('allowances', request.resource.data) && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.accountId == resource.data.accountId &&
        (operation('allowances', request.resource.data).command == 'saveRequisition' ? savedRequest(id, resource.data, request.resource.data) :
        operation('allowances', request.resource.data).command == 'reviewRequisition' ? reviewedRequest(resource.data, request.resource.data, operation('allowances', request.resource.data)) :
        operation('allowances', request.resource.data).command == 'releaseRequisition' ? resource.data.status == 'approved' && request.resource.data.status == 'released' && request.resource.data.releasedBy == request.auth.uid && recent(request.resource.data.releasedAt) && payment(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'releasedBy', 'releasedAt', 'paymentMethod', 'paymentDate', 'referenceNumber', 'updatedAt', 'lastOperationId']) && changedAccount(request.resource.data) :
        operation('allowances', request.resource.data).command == 'cancelRequisition' && resource.data.ownerUid == request.auth.uid && resource.data.status in ['draft', 'submitted', 'returned'] && request.resource.data.status == 'cancelled' && request.resource.data.get('id', id) == id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['id', 'status', 'updatedAt', 'lastOperationId']) && changedAccount(request.resource.data));
      allow delete: if false;
    }
    match /allowanceAttachments/{id} {
      allow create: if financial(request.resource.data, 'registerEvidenceReference') && ownedActive(request.resource.data) && request.resource.data.kind == 'reference' && request.resource.data.finalized && !request.resource.data.uploadAllowed && !request.resource.data.cleanupCandidate &&
        request.resource.data.reference.matches('[A-Z0-9_-]{1,64}') && request.resource.data.referenceUri is string && request.resource.data.referenceUri.size() <= 1000 && (request.resource.data.referenceUri == '' || request.resource.data.referenceUri.matches('https://.+')) && textField(request.resource.data.name, 200) &&
        money(request.resource.data.purchaseCentavos) && request.resource.data.purchaseCentavos <= account(request.resource.data).policy.dailyFuelCentavos &&
        record('allowanceLiquidations', request.resource.data.liquidationId).status in ['draft', 'returned'] && record('allowanceLiquidations', request.resource.data.liquidationId).accountId == request.resource.data.accountId && record('allowanceLiquidations', request.resource.data.liquidationId).date == request.resource.data.date &&
        afterRecord('allowanceLiquidations', request.resource.data.liquidationId).lastOperationId == request.resource.data.lastOperationId && afterRecord('allowanceLiquidations', request.resource.data.liquidationId).preparedAttachmentIds.hasAny([id]) &&
        (request.resource.data.purchaseCentavos == 0 || afterRecord('allowanceFuelReceipts', request.resource.data.accountId + '_' + request.resource.data.date + '_' + request.resource.data.reference).fileId == id);
      allow update: if financial(request.resource.data, 'saveLiquidation') && ownedActive(request.resource.data) && request.resource.data.get('id', id) == id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['id', 'cleanupCandidate', 'uploadAllowed', 'updatedAt', 'lastOperationId']) && !request.resource.data.cleanupCandidate && !request.resource.data.uploadAllowed;
      allow delete: if false;
    }
    match /allowanceFuelReceipts/{id} {
      allow create: if financial(request.resource.data, 'registerEvidenceReference') && ownedActive(request.resource.data) && afterRecord('allowanceAttachments', request.resource.data.fileId).lastOperationId == request.resource.data.lastOperationId &&
        id == request.resource.data.accountId + '_' + afterRecord('allowanceAttachments', request.resource.data.fileId).date + '_' + afterRecord('allowanceAttachments', request.resource.data.fileId).reference;
      allow update, delete: if false;
    }
    function fuelClaim(slip, day, i) {
      let line = slip.lines.size() > i ? slip.lines[i] : {};
      return slip.lines.size() <= i || line.category != 'Fuel' || afterRecord('allowanceReferenceFuelClaims', line.fuelPurchaseId).lastOperationId == slip.lastOperationId;
    }
    function fuelClaims(slip, day) { return fuelClaim(slip, day, 0) && fuelClaim(slip, day, 1) && fuelClaim(slip, day, 2) && fuelClaim(slip, day, 3) && fuelClaim(slip, day, 4); }
    function earlierPurchase(slip, i, j) { return j < i && slip.lines[j].category == 'Fuel' && slip.lines[j].fuelPurchaseId == slip.lines[i].fuelPurchaseId; }
    function allocationAmount(slip, day, i) {
      return slip.lines.size() <= i || slip.lines[i].category != 'Fuel' || earlierPurchase(slip, i, 0) || earlierPurchase(slip, i, 1) || earlierPurchase(slip, i, 2) || earlierPurchase(slip, i, 3) ? 0 : day.allocations[slip.meetingId].get(slip.lines[i].fuelPurchaseId, 0);
    }
    function meetingFuel(before, d, op) {
      let m = afterRecord('allowanceMeetings', op.result.id);
      let old = get(/databases/$(database)/documents/allowanceMeetings/$(op.result.id)).data;
      return m.lastOperationId == d.lastOperationId && (m.date == d.date || old != null && old.date == d.date) && d.fuelCentavos == before.get('fuelCentavos', 0) && d.get('allocations', {}) == before.get('allocations', {}) &&
        d.heldMeetingIds == before.get('heldMeetingIds', []).removeAll([op.result.id]).concat(m.status == 'held' && m.date == d.date ? [op.result.id] : []);
    }
    function slipFuel(before, d, op) {
      let id = op.command == 'saveLiquidation' ? op.payload.meetingId : op.payload.id;
      let slip = afterRecord('allowanceLiquidations', id);
      let old = get(/databases/$(database)/documents/allowanceLiquidations/$(id)).data;
      let oldFuel = op.command == 'correctLiquidation' || old != null && old.status == 'returned' ? old.fuelCentavos : 0;
      return slip.lastOperationId == d.lastOperationId && slip.date == d.date && slip.accountId == d.accountId && slip.status in ['submitted', 'voided'] &&
        d.heldMeetingIds == before.heldMeetingIds && d.fuelCentavos == before.fuelCentavos - oldFuel + (slip.status == 'voided' ? slip.correctedFuelCentavos : slip.fuelCentavos) &&
        d.allocations.diff(before.get('allocations', {})).affectedKeys().hasOnly([id]) && fuelClaims(slip, d) &&
        (slip.status != 'voided' || allocationAmount(slip, d, 0) + allocationAmount(slip, d, 1) + allocationAmount(slip, d, 2) + allocationAmount(slip, d, 3) + allocationAmount(slip, d, 4) == slip.correctedFuelCentavos);
    }
    match /allowanceDailyFuel/{id} {
      allow create, update: if currentOperation('allowances', request.resource.data) && id == request.resource.data.accountId + '_' + request.resource.data.date &&
        (operation('allowances', request.resource.data).command == 'correctLiquidation' || ownedActive(request.resource.data)) && request.resource.data.heldMeetingIds is list && request.resource.data.heldMeetingIds.toSet().size() == request.resource.data.heldMeetingIds.size() && money(request.resource.data.fuelCentavos) &&
        request.resource.data.fuelCentavos <= (request.resource.data.heldMeetingIds.size() >= 2 ? account(request.resource.data).policy.dailyFuelCentavos : account(request.resource.data).policy.singleFuelCentavos) &&
        (resource == null || request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.accountId == resource.data.accountId && request.resource.data.date == resource.data.date) &&
        (operation('allowances', request.resource.data).command == 'saveMeeting' ? meetingFuel(resource == null ? {} : resource.data, request.resource.data, operation('allowances', request.resource.data)) :
          operation('allowances', request.resource.data).command in ['saveLiquidation', 'correctLiquidation'] && resource != null && slipFuel(resource.data, request.resource.data, operation('allowances', request.resource.data)));
      allow delete: if false;
    }
    match /allowanceReferenceFuelClaims/{id} {
      allow create, update: if currentOperation('allowances', request.resource.data) && operation('allowances', request.resource.data).command in ['saveLiquidation', 'correctLiquidation'] && money(request.resource.data.allocatedCentavos) &&
        request.resource.data.ownerUid == record('allowanceAttachments', id).ownerUid && request.resource.data.accountId == record('allowanceAttachments', id).accountId && request.resource.data.date == record('allowanceAttachments', id).date && request.resource.data.allocatedCentavos <= record('allowanceAttachments', id).purchaseCentavos &&
        request.resource.data.allocatedCentavos == (resource == null ? 0 : resource.data.allocatedCentavos) - (exists(/databases/$(database)/documents/allowanceDailyFuel/$(request.resource.data.accountId + '_' + request.resource.data.date)) ? record('allowanceDailyFuel', request.resource.data.accountId + '_' + request.resource.data.date).get('allocations', {}).get(request.resource.data.slipId, {}).get(id, 0) : 0) + afterRecord('allowanceDailyFuel', request.resource.data.accountId + '_' + request.resource.data.date).allocations[request.resource.data.slipId].get(id, 0) &&
        allocationProof(request.resource.data, id);
      allow delete: if false;
    }
    function allocationProof(data, id) {
      let slip = afterRecord('allowanceLiquidations', data.slipId);
      let day = afterRecord('allowanceDailyFuel', data.accountId + '_' + data.date);
      let amount = day.allocations[data.slipId].get(id, 0);
      return slip.lastOperationId == data.lastOperationId && day.lastOperationId == data.lastOperationId && slip.accountId == data.accountId && slip.ownerUid == data.ownerUid &&
        (slip.status == 'submitted' ? amount == purchaseAmount(slip.lines, id) : slip.status == 'voided' && amount >= 0 && amount <= purchaseAmount(slip.lines, id));
    }
    match /allowanceLedger/{id} {
      allow create: if currentOperation('allowances', request.resource.data) && request.resource.data.actorUid == request.auth.uid && request.resource.data.accountId == operation('allowances', request.resource.data).accountId && request.resource.data.ownerUid == account(request.resource.data).ownerUid &&
        id in [request.resource.data.lastOperationId, request.resource.data.lastOperationId + '_reversal', request.resource.data.lastOperationId + '_replacement'] && recent(request.resource.data.createdAt) &&
        changedAccount(request.resource.data) && cashPost(nextAccount(request.resource.data), request.resource.data.kind, request.resource.data.amountCentavos, request.resource.data.sourceId, id == request.resource.data.lastOperationId ? '' : id == request.resource.data.lastOperationId + '_reversal' ? '_reversal' : '_replacement') &&
        (operation('allowances', request.resource.data).command == 'initialRelease' ? request.resource.data.kind == 'initial_release' && id == request.resource.data.lastOperationId :
        operation('allowances', request.resource.data).command == 'cashReturn' ? request.resource.data.kind == 'cash_return' && id == request.resource.data.lastOperationId :
        operation('allowances', request.resource.data).command == 'reviewLiquidation' ? request.resource.data.kind == 'approved_expense' && id == request.resource.data.lastOperationId :
        operation('allowances', request.resource.data).command == 'releaseRequisition' ? request.resource.data.kind == 'replenishment' && id == request.resource.data.lastOperationId :
        operation('allowances', request.resource.data).command == 'correctLiquidation' && id != request.resource.data.lastOperationId && request.resource.data.kind == (id == request.resource.data.lastOperationId + '_reversal' ? 'expense_reversal' : 'corrected_expense'));
      allow update, delete: if false;
    }
    function linkedExpense(data, id, before) {
      let slip = afterRecord('allowanceLiquidations', data.liquidationId);
      let op = operation('allowances', data);
      return currentOperation('allowances', data) && id == 'allowance_liquidation_' + data.liquidationId && data.source == 'allowance_liquidation' && data.allowanceAccountId == slip.accountId && slip.lastOperationId == data.lastOperationId && slip.ownerUid != request.auth.uid &&
        (before == null ? op.command == 'reviewLiquidation' && slip.status == 'approved' && slip.totalCentavos > 0 && data.amount == slip.totalCentavos / 100 && data.status == 'paid' && data.approvedLines == slip.lines :
          op.command == 'correctLiquidation' && slip.status == 'voided' && data.amount == slip.correctedTotalCentavos / 100 && data.correctedBy == request.auth.uid && data.get('id', id) == id && data.diff(before).affectedKeys().hasOnly(['id', 'amount', 'correctionReason', 'correctedAt', 'correctedBy', 'updatedAt', 'lastOperationId']));
    }
    match /expenses/{id} {
      allow create: if linkedExpense(request.resource.data, id, null);
      allow update: if linkedExpense(request.resource.data, id, resource.data);
    }
    match /allowanceReleases/{id} {
      allow create: if financial(request.resource.data, 'initialRelease') && id == request.resource.data.lastOperationId && request.resource.data.ownerUid == account(request.resource.data).ownerUid && request.resource.data.actorUid == request.auth.uid && payment(request.resource.data) && request.resource.data.amountCentavos == operation('allowances', request.resource.data).payload.amountCentavos && changedAccount(request.resource.data);
      allow update, delete: if false;
    }
    match /allowanceAuditEvents/{id} {
      allow create: if currentOperation('allowances', request.resource.data) && id == request.resource.data.lastOperationId && request.resource.data.actorUid == request.auth.uid && request.resource.data.command == operation('allowances', request.resource.data).command && recent(request.resource.data.createdAt) &&
        (operation('allowances', request.resource.data).command in ['savePolicy', 'grantAccess', 'configureAccount'] ? request.resource.data.ownerUid == request.auth.uid : request.resource.data.ownerUid == account(request.resource.data).ownerUid);
      allow update, delete: if false;
    }
    match /allowanceAccounts/{id} { allow read: if allowanceRead(); }
    match /allowanceMeetings/{id} { allow read: if allowanceRead(); }
    match /allowanceLiquidations/{id} { allow read: if allowanceRead(); }
    match /allowanceRequisitions/{id} { allow read: if allowanceRead(); }
    match /allowanceLedger/{id} { allow read: if allowanceRead(); }
    match /allowanceAuditEvents/{id} { allow read: if allowanceRead(); }
    match /allowanceDailyFuel/{id} { allow read: if allowanceRead(); }
    match /allowanceAttachments/{id} { allow read: if allowanceRead(); }
    match /allowanceReleases/{id} { allow read: if allowanceRead(); }
    match /allowanceFuelReceipts/{id} { allow read: if allowanceRead(); }
    match /allowanceReferenceFuelClaims/{id} { allow read: if allowanceRead(); }
    match /allowanceLiquidations/{id}/revisions/{revision} { allow read: if active('allowances') && (resource.data.ownerUid == request.auth.uid || allowanceReviewer()); }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
