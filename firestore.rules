rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /contactSubmissions/{docId} {
      allow create: if
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0 &&
        request.resource.data.goal is string && request.resource.data.goal.size() > 0 &&
        request.resource.data.submittedAt == request.time &&
        request.resource.data.keys().hasOnly([
          'name', 'email', 'company', 'goal', 'submittedAt', 'userAgent', 'referrer'
        ]);

      allow read, delete: if request.auth != null;
      allow update: if false;
    }

    match /invoices/{docId} {
      allow get: if request.auth != null || resource == null || resource.data.status != 'paid';
      allow list, create, update, delete: if request.auth != null;
    }

    match /expenses/{docId} {
      function linked(data) { return data.get('source', '') == 'allowance_liquidation' || data.keys().hasAny(['liquidationId', 'allowanceAccountId']); }
      allow read: if request.auth != null;
      allow create: if request.auth != null && !linked(request.resource.data) && !docId.matches('allowance_liquidation_.*');
      allow update: if request.auth != null && !linked(resource.data) && !linked(request.resource.data) && !docId.matches('allowance_liquidation_.*');
      allow delete: if request.auth != null && !linked(resource.data) && !docId.matches('allowance_liquidation_.*');
    }

    match /moas/{docId} {
      allow get: if request.auth != null || resource == null || resource.data.get('clientSigned', false) != true;
      allow create, delete: if request.auth != null;
      allow list: if request.auth != null;
      allow update: if request.auth != null || (
        resource.data.get('clientSigned', false) != true &&
        request.resource.data.clientSigned == true &&
        request.resource.data.clientSigneeName is string &&
        request.resource.data.clientSigneeName.size() > 0
      );
    }

    match /supportTickets/{ticketId} {
      allow read, create, update, delete: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, create, update, delete: if request.auth != null;
      }
    }

    match /clients/{docId} {
      allow get: if true;
      allow list, create, update, delete: if request.auth != null;
    }

    match /maintenanceSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /serviceInquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /inventory/{docId} {
      allow read, create, update, delete: if request.auth != null;
    }

    match /certificates/{docId} {
      allow create, delete: if request.auth != null;
      allow list: if request.auth != null;
      allow get: if request.auth != null || resource == null || resource.data.status != 'Accepted';
      allow update: if request.auth != null || (
        resource.data.status == 'Pending' &&
        request.resource.data.status == 'Accepted' &&
        request.resource.data.signeeName is string &&
        request.resource.data.signeeName.size() > 0
      );
    }

    match /staff/{docId} {
      allow read: if request.auth != null;
      allow create: if operationsRoot() || staffAction('staff:create');
      allow update: if operationsRoot() || staffAction('staff:edit') ||
        (staffAction('staff:status') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if operationsRoot() || staffAction('staff:delete');
    }

    match /salaryPayouts/{docId} {
      allow read, write: if request.auth != null;
    }

    match /clientFeedback/{docId} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }

    match /domains/{docId} {
      allow read, write: if request.auth != null;
    }

    // Spark-compatible operations. Public UI configuration never grants authority.
    function operationsRoot() { return request.auth != null && request.auth.uid == 'USkc70WnqpUV4Oq0ppPpdm2E4Fa2'; }
    function record(name, id) { return get(/databases/$(database)/documents/$(name)/$(id)).data; }
    function afterRecord(name, id) { return getAfter(/databases/$(database)/documents/$(name)/$(id)).data; }
    function staffAction(action) {
      let identity = record('staffLoginIdentities', request.auth.uid);
      let staff = record('staff', identity.staffId);
      return request.auth != null && staff.status == 'active' && staff.allowedActions.hasAny([action]);
    }
    function grantName(module) { return module == 'demos' ? 'demoAccess' : 'allowanceAccess'; }
    function activeGrant(grant) {
      let staff = record('staff', grant.staffId);
      return grant.active && !grant.get('bootstrapAdmin', false) && staff.status == 'active' && staff.email.lower() == request.auth.token.email.lower() && grant.get('email', staff.email).lower() == staff.email.lower();
    }
    function active(module) { return operationsRoot() || request.auth != null && activeGrant(record(grantName(module), request.auth.uid)); }
    function action(module, permission) { return operationsRoot() || (active(module) && record(grantName(module), request.auth.uid).actions.hasAny([module + ':' + permission])); }
    function hasAction(module, permission) { return operationsRoot() || record(grantName(module), request.auth.uid).actions.hasAny([module + ':' + permission]); }
    function allowanceReviewer() { return operationsRoot() || (active('allowances') && record('allowanceAccess', request.auth.uid).actions.hasAny(['allowances:manage', 'allowances:review', 'allowances:approve', 'allowances:release', 'allowances:reports', 'allowances:reverse'])); }
    function allowanceRead() { return active('allowances') && (resource == null || resource.data.ownerUid == request.auth.uid || allowanceReviewer()); }
    function money(value) { return value is int && value >= 0 && value <= 100000000; }
    function pad(value) { return value < 10 ? '0' + string(value) : string(value); }
    function dateKey(value) { return string(value.year()) + '-' + pad(value.month()) + '-' + pad(value.day()); }
    function today() { return dateKey(request.time + duration.value(8, 'h')); }
    function isoTime(value) { return dateKey(value) + 'T' + pad(value.hours()) + ':' + pad(value.minutes()) + ':00.000Z'; }
    function validDate(value) { return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'); }
    function recent(value) { return value is timestamp && value >= request.time - duration.value(2, 'm') && value <= request.time + duration.value(2, 'm'); }
    function operation(module, data) { return afterRecord(module == 'demos' ? 'demoCommandResults' : 'allowanceCommandResults', data.lastOperationId); }
    function currentOperation(module, data) { let op = operation(module, data); return op.actorUid == request.auth.uid && op.createdAt == request.time; }
    function validCommand(module, command) {
      let allowanceActions = {'savePolicy': 'manage', 'grantAccess': 'manage', 'configureAccount': 'manage', 'reconcileCash': 'manage', 'initialRelease': 'release', 'cashReturn': 'release', 'saveMeeting': 'meeting', 'saveLiquidation': 'liquidate', 'registerEvidenceReference': 'liquidate', 'reviewLiquidation': 'review', 'saveRequisition': 'request', 'reviewRequisition': 'approve', 'releaseRequisition': 'release', 'cancelRequisition': 'request', 'correctLiquidation': 'reverse'};
      let demoActions = {'saveSettings': 'manage', 'grantAccess': 'manage', 'setMyPresenter': 'manage', 'saveAvailability': 'present', 'book': 'book', 'reschedule': 'book', 'cancel': 'book', 'complete': 'present', 'noShow': 'present', 'markRead': 'present'};
      return module == 'allowances' ? allowanceActions.get(command, '') != '' && action(module, allowanceActions[command]) :
        command in demoActions && (action(module, 'manage') || action(module, demoActions[command]) ||
          (command in ['reschedule', 'cancel', 'markRead'] && active(module) && (command == 'markRead' || action(module, 'present'))));
    }
    function identityMatches(uid, staffId) { let identity = record('staffLoginIdentities', uid); return identity.uid == uid && identity.staffId == staffId && identity.email == record('staff', staffId).email.lower(); }
    match /staffLoginIdentities/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || action('demos', 'manage') || action('allowances', 'manage'));
      allow list: if action('demos', 'manage') || action('allowances', 'manage');
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['uid', 'staffId', 'email', 'createdAt']) && request.resource.data.uid == uid &&
        request.resource.data.email == record('staff', request.resource.data.staffId).email.lower() && request.resource.data.createdAt == request.time &&
        (operationsRoot() || action('demos', 'manage') || action('allowances', 'manage') || (request.auth.uid == uid && request.auth.token.email.lower() == request.resource.data.email));
      allow update, delete: if false;
    }
    function validGrant(module, uid) {
      let data = request.resource.data;
      let allowed = module == 'demos' ? ['demos:book', 'demos:present', 'demos:view_all', 'demos:manage'] : ['allowances:manage', 'allowances:meeting', 'allowances:liquidate', 'allowances:review', 'allowances:request', 'allowances:approve', 'allowances:release', 'allowances:reports', 'allowances:reverse'];
      return data.active is bool && data.actions is list && data.actions.hasOnly(allowed) &&
        (uid == 'USkc70WnqpUV4Oq0ppPpdm2E4Fa2' ? operationsRoot() && data.active && data.bootstrapAdmin == true && data.staffId == '' && data.actions.hasAll(allowed) :
          data.get('bootstrapAdmin', false) == false && identityMatches(uid, data.staffId) && data.email.lower() == record('staff', data.staffId).email.lower() && (!data.active || record('staff', data.staffId).status == 'active')) &&
        (module != 'demos' || (data.uid == uid && data.presenterEnabled is bool && (!data.presenterEnabled || data.active && data.actions.hasAny(['demos:present'])) &&
          (resource == null || !resource.data.get('presenterEnabled', false) || data.presenterEnabled || !exists(/databases/$(database)/documents/demoPresenterState/$(uid)) || record('demoPresenterState', uid).confirmedCount == 0)));
    }
    match /demoAccess/{uid} {
      allow get: if request.auth != null && (uid == request.auth.uid || active('demos'));
      allow list: if action('demos', 'manage') || active('demos') && resource.data.active && resource.data.presenterEnabled;
      allow create, update: if action('demos', 'manage') && validGrant('demos', uid);
      allow delete: if false;
    }
    match /allowanceAccess/{uid} {
      allow get: if request.auth != null && (uid == request.auth.uid || allowanceReviewer());
      allow list: if allowanceReviewer();
      allow create, update: if action('allowances', 'manage') && request.resource.data.ownerUid == uid && validGrant('allowances', uid);
      allow delete: if false;
    }
    match /staffPermissionAuditEvents/{id} {
      allow read: if operationsRoot();
      allow create: if request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time &&
        request.resource.data.modules.hasOnly(['demos', 'allowances']) && request.resource.data.modules.size() > 0 &&
        (!request.resource.data.modules.hasAny(['demos']) || action('demos', 'manage')) && (!request.resource.data.modules.hasAny(['allowances']) || action('allowances', 'manage'));
      allow update, delete: if false;
    }
    match /demoCommandResults/{id} {
      allow get: if active('demos') && (resource == null || resource.data.actorUid == request.auth.uid);
      allow create: if id.matches(request.auth.uid + '_.+') && request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time && validCommand('demos', request.resource.data.command) &&
        (request.resource.data.command == 'markRead' || afterRecord('demoAuditEvents', id).lastOperationId == id);
      allow update, delete, list: if false;
    }
    match /allowanceCommandResults/{id} {
      allow get: if active('allowances') && (resource == null || resource.data.actorUid == request.auth.uid);
      allow create: if id.matches(request.auth.uid + '_.+') && request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time && validCommand('allowances', request.resource.data.command) &&
        (request.resource.data.command in ['savePolicy', 'grantAccess'] || record('allowanceSettings', 'current').enabled) && afterRecord('allowanceAuditEvents', id).lastOperationId == id;
      allow update, delete, list: if false;
    }
    function bookingVisible(data) { return hasAction('demos', 'manage') || hasAction('demos', 'view_all') || data.get('presenterUid', '') == request.auth.uid || data.get('bookedByUid', '') == request.auth.uid || data.get('recipientUids', []).hasAny([request.auth.uid]); }
    function bookingEditor(data) { return hasAction('demos', 'manage') || data.bookedByUid == request.auth.uid || data.presenterUid == request.auth.uid; }
    function presenterReady(uid) {
      let grant = record('demoAccess', uid);
      return grant.active && grant.presenterEnabled && grant.actions.hasAny(['demos:present']) &&
        (uid == 'USkc70WnqpUV4Oq0ppPpdm2E4Fa2' || record('staff', grant.staffId).status == 'active');
    }
    function slotEntry(data, i) { return data.slotKeys.size() <= i || data.slotKeys[i] == string(int(data.startMinute / 15) + i); }
    function slotList(data) {
      let s = int(data.startMinute / 15);
      let slots = [string(s), string(s + 1), string(s + 2), string(s + 3), string(s + 4), string(s + 5), string(s + 6), string(s + 7), string(s + 8), string(s + 9), string(s + 10), string(s + 11)];
      return data.slotKeys is list && data.slotKeys.size() == (data.duration + data.bufferMinutes) / 15 && data.slotKeys.size() <= 12 && data.slotKeys == slots[0:data.slotKeys.size()];
    }
    function claimedSlot(data, claims, i) { return data.slotKeys.size() <= i || claims.get(data.slotKeys[i], '') == data.id; }
    function claimsHeld(data) {
      let claims = afterRecord('demoDays', data.presenterUid + '_' + data.date).claims;
      return claimedSlot(data, claims, 0) && claimedSlot(data, claims, 1) && claimedSlot(data, claims, 2) && claimedSlot(data, claims, 3) && claimedSlot(data, claims, 4) && claimedSlot(data, claims, 5) &&
        claimedSlot(data, claims, 6) && claimedSlot(data, claims, 7) && claimedSlot(data, claims, 8) && claimedSlot(data, claims, 9) && claimedSlot(data, claims, 10) && claimedSlot(data, claims, 11);
    }
    function releasedSlot(before, data, day, i) {
      return before.slotKeys.size() <= i || (data.status == 'confirmed' && data.presenterUid == before.presenterUid && data.date == before.date && data.slotKeys.hasAny([before.slotKeys[i]])) || !day.claims.keys().hasAny([before.slotKeys[i]]);
    }
    function claimsReleased(before, data) {
      let day = afterRecord('demoDays', before.presenterUid + '_' + before.date);
      let retained = data.status == 'confirmed' && data.presenterUid == before.presenterUid && data.date == before.date ? data.slotKeys.toSet() : [].toSet();
      return day.claims.keys().toSet().intersection(before.slotKeys.toSet().difference(retained)).size() == 0;
    }
    function bookingTimeShape(data) {
      return data.startsAt is timestamp && data.endsAt is timestamp && data.dayAt is timestamp && data.dayAt == data.dayAt.date() && data.date == dateKey(data.dayAt) &&
        data.weekday == data.dayAt.dayOfWeek() % 7 && data.startMinute is int && data.startMinute >= 0 && data.startMinute % 15 == 0 &&
        data.endMinute == data.startMinute + data.duration && data.occupiedEndMinute == data.endMinute + data.bufferMinutes && data.occupiedEndMinute < 1440 &&
        data.startsAt == data.dayAt + duration.value(data.startMinute - 480, 'm') && data.endsAt == data.startsAt + duration.value(data.duration, 'm') &&
        data.time == pad(int(data.startMinute / 60)) + ':' + pad(data.startMinute % 60) &&
        data.recipientUids.toSet() == [data.bookedByUid, data.presenterUid].toSet() && data.updatedByUid == request.auth.uid && slotList(data);
    }
    function bookingShape(data) {
      return bookingTimeShape(data) && data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 200 &&
        data.contactName is string && data.contactName.size() > 0 && data.contactName.size() <= 200 && (data.contactEmail.size() > 0 || data.contactPhone.size() > 0) &&
        data.topic is string && data.topic.size() > 0 && data.topic.size() <= 300 && data.mode in ['online', 'onsite'] && data.location is string && data.location.size() > 0 &&
        (data.mode != 'online' || data.location.matches('https://.+'));
    }
    function schedulingAllowed(data) {
      let settings = record('demoSettings', 'current');
      let day = afterRecord('demoDays', data.presenterUid + '_' + data.date);
      let available = day.override ? day.availableSlots : record('demoAvailability', data.presenterUid).weeklySlots[string(data.weekday)];
      return settings.enabled && settings.policy.durations.hasAny([data.duration]) && data.bufferMinutes == settings.policy.bufferMinutes && presenterReady(data.presenterUid) &&
        data.startsAt >= request.time + duration.value(settings.policy.minimumNoticeMinutes, 'm') && data.dayAt <= (request.time + duration.value(8, 'h')).date() + duration.value(settings.policy.bookingWindowDays, 'd') &&
        available.hasAll(data.slotKeys) && claimsHeld(data) && afterRecord('demoPresenterState', data.presenterUid).lastOperationId == data.lastOperationId;
    }
    function bookingTransition(before, data) {
      let command = operation('demos', data).command;
      return command == 'reschedule' ? before.startsAt > request.time && data.status == 'confirmed' && bookingTimeShape(data) && schedulingAllowed(data) :
        data.diff(before).affectedKeys().hasOnly(['status', 'version', 'updatedAt', 'updatedByUid', 'outcomeNotes', 'lastOperationId']) && data.updatedByUid == request.auth.uid &&
        (command == 'cancel' ? data.status == 'cancelled' : command in ['complete', 'noShow'] && before.endsAt <= request.time && (hasAction('demos', 'manage') || before.presenterUid == request.auth.uid) && data.status == (command == 'complete' ? 'completed' : 'no_show'));
    }
    match /demoBookings/{id} {
      allow get: if active('demos') && (resource == null || bookingVisible(resource.data));
      allow list: if active('demos') && bookingVisible(resource.data);
      allow create: if currentOperation('demos', request.resource.data) && operation('demos', request.resource.data).command == 'book' && request.resource.data.id == id &&
        request.resource.data.bookedByUid == request.auth.uid && request.resource.data.version == 1 && request.resource.data.status == 'confirmed' && bookingShape(request.resource.data) && schedulingAllowed(request.resource.data);
      allow update: if currentOperation('demos', request.resource.data) && bookingEditor(resource.data) && resource.data.status == 'confirmed' &&
        request.resource.data.version == resource.data.version + 1 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'time', 'duration', 'bufferMinutes', 'presenterUid', 'presenterName', 'recipientUids', 'status', 'version', 'updatedAt', 'updatedByUid', 'outcomeNotes', 'startMinute', 'endMinute', 'occupiedEndMinute', 'startAt', 'endAt', 'startsAt', 'endsAt', 'dayAt', 'weekday', 'slotKeys', 'lastOperationId']) &&
        claimsReleased(resource.data, request.resource.data) && afterRecord('demoPresenterState', resource.data.presenterUid).lastOperationId == request.resource.data.lastOperationId && bookingTransition(resource.data, request.resource.data);
      allow delete: if false;
    }
    function bookingCount(data, uid) { return data != null && data.status == 'confirmed' && data.presenterUid == uid ? 1 : 0; }
    match /demoPresenterState/{uid} {
      allow get: if active('demos');
      allow create, update: if currentOperation('demos', request.resource.data) && request.resource.data.keys().hasOnly(['confirmedCount', 'version', 'bookingId', 'lastOperationId']) &&
        request.resource.data.lastOperationId == afterRecord('demoBookings', request.resource.data.bookingId).lastOperationId &&
        request.resource.data.confirmedCount == (resource == null ? 0 : resource.data.confirmedCount) + bookingCount(afterRecord('demoBookings', request.resource.data.bookingId), uid) - (exists(/databases/$(database)/documents/demoBookings/$(request.resource.data.bookingId)) ? bookingCount(record('demoBookings', request.resource.data.bookingId), uid) : 0) &&
        request.resource.data.confirmedCount >= 0 && request.resource.data.version == (resource == null ? 1 : resource.data.version + 1);
      allow delete, list: if false;
    }
    function weeklySlots(data) {
      return data.keys().hasOnly(['0', '1', '2', '3', '4', '5', '6']) && data.keys().hasAll(['0', '1', '2', '3', '4', '5', '6']) &&
        data['0'].size() <= 96 && data['1'].size() <= 96 && data['2'].size() <= 96 && data['3'].size() <= 96 && data['4'].size() <= 96 && data['5'].size() <= 96 && data['6'].size() <= 96;
    }
    function weeklyExpanded(data, before) { return data['0'].hasAll(before['0']) && data['1'].hasAll(before['1']) && data['2'].hasAll(before['2']) && data['3'].hasAll(before['3']) && data['4'].hasAll(before['4']) && data['5'].hasAll(before['5']) && data['6'].hasAll(before['6']); }
    match /demoAvailability/{uid} {
      allow get: if active('demos');
      allow create, update: if currentOperation('demos', request.resource.data) && operation('demos', request.resource.data).command == 'saveAvailability' && (hasAction('demos', 'manage') || uid == request.auth.uid) && presenterReady(uid) &&
        request.resource.data.weekly is map && request.resource.data.overrides is map && request.resource.data.overrides.size() <= 120 && weeklySlots(request.resource.data.weeklySlots) &&
        (resource == null || !exists(/databases/$(database)/documents/demoPresenterState/$(uid)) || record('demoPresenterState', uid).confirmedCount == 0 || weeklyExpanded(request.resource.data.weeklySlots, resource.data.weeklySlots));
      allow delete, list: if false;
    }
    function dayBooking(data, before) {
      let booking = afterRecord('demoBookings', data.changedBookingId);
      let old = exists(/databases/$(database)/documents/demoBookings/$(data.changedBookingId)) ? record('demoBookings', data.changedBookingId) : null;
      let keys = booking.slotKeys.concat(old == null ? [] : old.slotKeys);
      return booking.lastOperationId == data.lastOperationId && (data.presenterUid + '_' + data.date == booking.presenterUid + '_' + booking.date || old != null && data.presenterUid + '_' + data.date == old.presenterUid + '_' + old.date) &&
        data.claims.diff(before.get('claims', {})).affectedKeys().hasOnly(keys) && data.reservations.diff(before.get('reservations', {})).affectedKeys().hasOnly([booking.id]) &&
        (booking.status == 'confirmed' && booking.presenterUid == data.presenterUid && booking.date == data.date ? data.reservations.get(booking.id, {}) == {'startMinute': booking.startMinute, 'occupiedEndMinute': booking.occupiedEndMinute} : !data.reservations.keys().hasAny([booking.id])) &&
        data.get('override', false) == before.get('override', false) && data.get('availableSlots', []) == before.get('availableSlots', []);
    }
    match /demoDays/{id} {
      allow get: if active('demos');
      allow create, update: if currentOperation('demos', request.resource.data) && id == request.resource.data.presenterUid + '_' + request.resource.data.date && request.resource.data.claims is map && request.resource.data.reservations is map && request.resource.data.dayAt is timestamp && request.resource.data.date == dateKey(request.resource.data.dayAt) &&
        (operation('demos', request.resource.data).command == 'saveAvailability' ?
          (hasAction('demos', 'manage') || request.resource.data.presenterUid == request.auth.uid) && request.resource.data.claims == (resource == null ? {} : resource.data.claims) && request.resource.data.reservations == (resource == null ? {} : resource.data.reservations) &&
            request.resource.data.availableSlots is list && request.resource.data.availableSlots.size() <= 96 && request.resource.data.availableSlots.hasAll(request.resource.data.claims.keys()) &&
            (request.resource.data.override || request.resource.data.availableSlots == afterRecord('demoAvailability', request.resource.data.presenterUid).weeklySlots[string(request.resource.data.dayAt.dayOfWeek() % 7)]) :
          dayBooking(request.resource.data, resource == null ? {} : resource.data));
      allow delete, list: if false;
    }
    match /demoSettings/{id} {
      allow read: if active('demos');
      allow create, update: if id == 'current' && currentOperation('demos', request.resource.data) && operation('demos', request.resource.data).command == 'saveSettings' &&
        request.resource.data.enabled is bool && request.resource.data.policy.durations.hasOnly([30, 45, 60, 90, 120]) && request.resource.data.policy.durations.size() > 0 &&
        request.resource.data.policy.bufferMinutes is int && request.resource.data.policy.bufferMinutes >= 0 && request.resource.data.policy.bufferMinutes <= 60 && request.resource.data.policy.bufferMinutes % 15 == 0 &&
        request.resource.data.policy.minimumNoticeMinutes is int && request.resource.data.policy.minimumNoticeMinutes >= 0 && request.resource.data.policy.minimumNoticeMinutes <= 10080 &&
        request.resource.data.policy.bookingWindowDays is int && request.resource.data.policy.bookingWindowDays >= 1 && request.resource.data.policy.bookingWindowDays <= 90;
      allow delete: if false;
    }
    match /demoNotifications/{id} {
      allow read: if active('demos') && resource.data.recipientUid == request.auth.uid;
